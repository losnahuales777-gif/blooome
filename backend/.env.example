# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000
# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
# Pon 1 solo si la API corre detras de un proxy inverso (nginx, load balancer)
TRUST_PROXY=0

# MongoDB Atlas: Database > Connect > Drivers > Node.js. Usa un usuario de base de datos con rol
# "readWrite" solo sobre la base "nutria" (no el usuario administrador del proyecto).
# Si la clave tiene caracteres especiales (@ : / ? # %), codificalos en la URL (p. ej. @ -> %40).
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nutria

# Minimo 32 caracteres. Genera uno con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=15

# Bloqueo de cuenta tras intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Etapa 6: llave AES-256 (32 bytes en base64). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarda una copia segura fuera del servidor: sin ella los datos cifrados no se pueden leer.
DATA_ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
SESSION_IDLE_MINUTES=30

# Asistente de IA para sugerir planes (opcional). Sin clave, la funcion queda desactivada.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Proveedor del asistente: anthropic (Claude, predeterminado) o gemini (Google AI Studio).
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

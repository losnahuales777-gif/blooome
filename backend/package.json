{
  "name": "lanutria-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de La Nutria - arquitectura MBS (Model - Business - Service) sobre MongoDB Atlas",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test ../calculations/test/ test/unit/",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "create-superuser": "node --env-file-if-exists=.env scripts/create-superuser.js",
    "audit:deps": "npm audit --omit=dev",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "catalog:import": "node --env-file-if-exists=.env scripts/import-catalog.js",
    "migrate:stage6": "node --env-file-if-exists=.env scripts/migrate-stage6.js",
    "migrate:stage2": "node --env-file-if-exists=.env scripts/migrate-stage2.js",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
